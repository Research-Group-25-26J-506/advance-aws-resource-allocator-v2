# EKS service manifest template (the EKS analog of ecs-service). The platform renders this with
# the service's values, base64-encodes it, and triggers the eks-deployer CodeBuild which runs
# `kubectl apply`. Placeholders: ${SERVICE}, ${IMAGE}, ${PORT}, ${REPLICAS}, ${ENV}.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: ${SERVICE}-${ENV}
  namespace: platform-apps
  labels: { app: ${SERVICE}, env: ${ENV}, managedBy: platform }
spec:
  replicas: ${REPLICAS}
  selector:
    matchLabels: { app: ${SERVICE}, env: ${ENV} }
  template:
    metadata:
      labels: { app: ${SERVICE}, env: ${ENV} }
    spec:
      containers:
        - name: app
          image: ${IMAGE}
          ports: [{ containerPort: ${PORT} }]
          readinessProbe:
            httpGet: { path: /health, port: ${PORT} }
            initialDelaySeconds: 5
---
apiVersion: v1
kind: Service
metadata:
  name: ${SERVICE}-${ENV}
  namespace: platform-apps
spec:
  selector: { app: ${SERVICE}, env: ${ENV} }
  ports: [{ port: 80, targetPort: ${PORT} }]
  type: ClusterIP
