{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SQS Queue",
  "type": "object",
  "required": ["queueName"],
  "additionalProperties": false,
  "properties": {
    "queueName": {
      "type": "string",
      "title": "Queue name",
      "pattern": "^[a-zA-Z0-9_-]{1,70}$"
    },
    "visibilityTimeoutSeconds": {
      "type": "integer",
      "title": "Visibility timeout (seconds)",
      "minimum": 0,
      "maximum": 43200,
      "default": 30,
      "x-help": "Must exceed your consumer's max processing time."
    },
    "messageRetentionDays": {
      "type": "string",
      "title": "Message retention (days)",
      "enum": ["1", "4", "7", "14"],
      "default": "4"
    },
    "withDlq": {
      "type": "boolean",
      "title": "Create dead-letter queue",
      "default": true,
      "x-help": "Strongly recommended — poison messages land here instead of looping."
    },
    "maxReceiveCount": {
      "type": "integer",
      "title": "Max receives before DLQ",
      "minimum": 1,
      "maximum": 100,
      "default": 5
    }
  }
}
